@page
@model MyGames.Pages.Games.CreateModel

@{
    ViewData["Title"] = "Create Game";
}

<h1>Create</h1>

<h4>Game</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="Game.Title" class="control-label"></label>
                <input asp-for="Game.Title" class="form-control" />
                <span asp-validation-for="Game.Title" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Game.ReleaseDate" class="control-label">Release Date</label>
                <input asp-for="Game.ReleaseDate" class="form-control" />
                <span asp-validation-for="Game.ReleaseDate" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Game.HoursPlayed" class="control-label">Hours Played</label>
                <input asp-for="Game.HoursPlayed" class="form-control" />
                <span asp-validation-for="Game.HoursPlayed" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Game.PublisherId" class="control-label">Publisher</label>
                <select asp-for="Game.PublisherId" class ="form-control" asp-items="Model.PublisherOptions"></select>
            </div>
            <div class="form-group form-check">
                <label class="form-check-label">
                    <input class="form-check-input" asp-for="Game.Favorite" /> @Html.DisplayNameFor(model => model.Game.Favorite)
                </label>
            </div>
            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-page="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
